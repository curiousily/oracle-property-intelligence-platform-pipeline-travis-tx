{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "travis-oracle-explorer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ipfs/*"]
  },
  "r2_buckets": [{ "binding": "MIRROR", "bucket_name": "travis-oracle-mirror", "remote": true }],
  "kv_namespaces": [
    { "binding": "AGENT_STORE", "id": "944c2e5f45ce42309c8a8b748800fd0f", "remote": true }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "vars": {
    "AGENT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AGENT_DAILY_NEURONS": "4500",
    "IPFS_GATEWAYS": "https://ipfs.orbitor.dev,https://gw.ipfs-lens.dev,https://gateway.pinata.cloud"
  }
}
